<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Flags are fetched over HTTPS, so the permission belongs to the library that needs
      it rather than being something every consumer has to discover for themselves.
      Without it, a host app that does not already declare INTERNET gets a
      SecurityException from inside Coil and a silent error painter, with nothing
      pointing at the cause.

      INTERNET is a normal-level permission: granted at install time, no runtime prompt.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
